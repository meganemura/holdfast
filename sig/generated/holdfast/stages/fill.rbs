        attr_reader origin(): String

        attr_reader dir(): String

        attr_reader rev(): String

        attr_reader report(): json

        attr_reader inputs(): Inputs

        attr_reader observed(): Array[json]

        attr_reader input_errors(): Array[String]

        def self.new: (Target target, String origin, String dir, String rev, json report, Inputs inputs, Array[json] observed, Array[String] input_errors) -> instance
                    | (target: Target, origin: String, dir: String, rev: String, report: json, inputs: Inputs, observed: Array[json], input_errors: Array[String]) -> instance

        def self.members: () -> [ :target, :origin, :dir, :rev, :report, :inputs, :observed, :input_errors ]

        def members: () -> [ :target, :origin, :dir, :rev, :report, :inputs, :observed, :input_errors ]
      end

