    # : (String text) -> [Array[String], Array[String]]
    def self.logic_split: (String text) -> [ Array[String], Array[String] ]

    # : (String ruby) -> untyped
    def self.top_node: (String ruby) -> untyped

    # `a && b && c` is three operands, so a failed line can name the one
