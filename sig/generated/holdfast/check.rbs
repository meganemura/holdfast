    # One `expect` line: its text, the Ruby that checks it, what to show
    # when it fails, its operands, and the calls and errors it reads.
    type expectation = Hash[Symbol, untyped]

    # +calls+ are the [class, method] pairs `expect` counts; +shared+ the
    # locals `do` sets and `expect` reads.
    class Suspicion < Data
      attr_reader id(): String

      attr_reader says(): String

      attr_reader given(): Hash[untyped, untyped]

      attr_reader acts(): Array[String]

      attr_reader pause(): String?

      attr_reader expects(): Array[expectation]

      attr_reader calls(): Array[[ String, String ]]

      attr_reader errors(): bool

      attr_reader source(): String

      attr_reader shared(): Array[Symbol]

      def self.new: (String id, String says, Hash[untyped, untyped] given, Array[String] acts, String? pause, Array[expectation] expects, Array[[ String, String ]] calls, bool errors, String source, Array[Symbol] shared) -> instance
