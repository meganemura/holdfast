      def self.members: () -> [ :id, :says, :given, :acts, :pause, :expects, :calls, :errors, :source, :shared ]

      def members: () -> [ :id, :says, :given, :acts, :pause, :expects, :calls, :errors, :source, :shared ]
    end

    SUPPORT: Array[String]

    SIDE_NUMBERS: Hash[String, String]

    COMPARE: Array[Symbol]

    # The rows, the summary header, and where they were written.
    # : (String root, files: Array[String], inline: Array[String], ?base: String?, ?here: bool?) -> [Array[Verdict], Array[String], Place]
    def self.run: (String root, files: Array[String], inline: Array[String], ?base: String?, ?here: bool?) -> [ Array[Verdict], Array[String], Place ]

    # Specs and outputs of one branch, so a branch switch neither mixes kept
    # specs nor shows another branch's rows. A detached HEAD is keyed by its
    # commit.
    class Place < Data
      attr_reader key(): String

      attr_reader label(): String

      def self.new: (String key, String label) -> instance
                  | (key: String, label: String) -> instance

      def self.members: () -> [ :key, :label ]

      def members: () -> [ :key, :label ]
    end

    class Place
