# Generated from lib/holdfast/runtime/reach.rb with RBS::Inline

# Which of the values the change added or removed (HOLDFAST_VALUES, each
# value's text in base64, comma-separated) an input drew: a row written with
# that value. Reads do not count: a scope that selects by a constant puts
# every member in each query.
HOLDFAST_WANTED: Array[String]

HOLDFAST_DREW: Array[String]

# What ran since the last take, as { file => lines } and { file => arms },
# for the app's own files. Each take clears the counts, so the file's total
# is the union of every take.
HOLDFAST_ROOT: String

# `ruby file` keeps the file in $0, not in ARGV, as Minitest runs.
HOLDFAST_SCRIPT: String

HOLDFAST_TOTAL: Hash[String, Hash[String, Array[Integer | String]]]

# One test file holds examples that agree and examples the change added, so
# a file's lines cannot say which example drew a new branch. Each example's
# own lines are kept by the line it is declared on, the line jitcatch
# reports for it.
HOLDFAST_EXAMPLES: Hash[Integer?, Hash[String, Hash[String, Array[Integer | String]]]]

