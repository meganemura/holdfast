    attr_reader target(): String

    attr_reader stage(): String

    attr_reader kind(): String

    attr_reader reason(): String

    attr_reader scope(): String?

    attr_reader evidence(): Array[String]

    attr_reader repro(): String?

    attr_reader next_step(): String

    attr_reader shown(): bool

