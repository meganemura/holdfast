  # : () -> Set[Symbol]
  def self.outside_callers: () -> Set[Symbol]

  # : () -> Hash[Symbol, Set[Module]]
  def self.outside_classes: () -> Hash[Symbol, Set[Module]]

  # What the run reached, so a clean result says what it covered: an action
  # that was only ever refused, or never drawn, checked nothing.
  # : (Symbol name, outcome? outcome) -> void
  def self.tally: (Symbol name, outcome? outcome) -> void

  # : (outcome? outcome) -> String
  def self.kind: (outcome? outcome) -> String

  # Plain random draws for the probe: no shrinking, no Hegel.
  class RandomDraw
    @random: Random

    # : (Random random) -> void
    def initialize: (Random random) -> void

    # : (Integer size) -> Integer
    def index: (Integer size) -> Integer

    # : (Range[Integer] range) -> Integer
    def int: (Range[Integer] range) -> Integer

    # : (bool ok) -> bool
    def assume: (bool ok) -> bool
  end

  # A random walk over every action with no invariants: the tables each
  # action writes, the outside services it calls, and how it ends. propose.rb
  # groups actions into areas by it.
  # : (Definition definition, ?walks: Integer, ?steps: Integer, ?seed: Integer) -> Hash[Symbol, action_stats]
  def self.probe: (Definition definition, ?walks: Integer, ?steps: Integer, ?seed: Integer) -> Hash[Symbol, action_stats]

  # : () -> String
  def self.coverage_report: () -> String

  # : (Array[entry] log) -> Array[Integer]
  def self.world_sizes: (Array[entry] log) -> Array[Integer]

  # The fakes are plain objects that remember charges and failures armed; a
  # trial's rollback must undo those too.
  # : () -> outside_state
  def self.save_outside_state: () -> outside_state

  # : (outside_state) -> void
  def self.restore_outside_state: (outside_state) -> void

  # : () -> bool
  def self.postgres?: () -> bool

  # Only PostgreSQL keeps id counters outside the transaction a trial rolls
  # back; SQLite's sqlite_sequence is a table, rolled back with the rows.
  # : () -> String
  def self.sequence_state_sql: () -> String

  # : () -> Set[Module]
  def self.outside_classes_declared: () -> Set[Module]

  # : (Definition definition, Array[entry] entries) -> Array[entry]
  def self.replay: (Definition definition, Array[entry] entries) -> Array[entry]

  # : () -> void
  def self.reset_database: () -> void

  # A 404 or 422 renders the plain error page, not the developer page:
  # building that page (source extracts, error highlight) took a third of
  # the run. The status the action answers is unchanged.
  # : () -> false
  def self.quiet_errors: () -> false

  # Empties every table and restarts its ids, so two runs of the same steps
  # get the same ids. DELETE in foreign-key order (children first) took 1 ms
  # on this app's few rows where TRUNCATE ... RESTART IDENTITY took 72 ms.
  # A schema whose keys form a cycle falls back to TRUNCATE. SQLite has no
  # TRUNCATE and no sequences: DELETE with the foreign keys off, then
  # sqlite_sequence, which holds the ids to restart.
  # : () -> void
  def self.empty_tables: () -> void

  # : (untyped conn) -> void
  def self.empty_tables_without_truncate: (untyped conn) -> void

  # : [T] (String zone) { () -> T } -> T
  def self.with_zone: [T] (String zone) { () -> T } -> T

  # : (Definition definition, Array[entry] log, String zone) -> Hash[String, Array[Hash[String, untyped]]]
  def self.replay_snapshot: (Definition definition, Array[entry] log, String zone) -> Hash[String, Array[Hash[String, untyped]]]

  # : (Hash[String, Array[Hash[String, untyped]]] a, Hash[String, Array[Hash[String, untyped]]] b, Set[String] noise) -> Array[{ column: String, text: String }]
  def self.diff: (Hash[String, Array[Hash[String, untyped]]] a, Hash[String, Array[Hash[String, untyped]]] b, Set[String] noise) -> Array[{ column: String, text: String }]

  # Last in the module: rbs-inline reads `module_function` as applying to
  # every method after it in the file.
  module Report
    # : (Array[entry] log) -> String
    def self?.narrative: (Array[entry] log) -> String

    # : (Definition definition, Array[entry] log) -> String
    def self?.pasteable: (Definition definition, Array[entry] log) -> String
  end
end
