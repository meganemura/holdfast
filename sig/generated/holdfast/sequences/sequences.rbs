    # and the rows of +tables+ (every table when nil) without ids, times and
    # random tokens.
    # : (String outcome, ?Array[String]? tables) -> effect
    def effect: (String outcome, ?Array[String]? tables) -> effect

    NOISE_COLUMN: Regexp

